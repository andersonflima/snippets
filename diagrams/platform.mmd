---
config:
  theme: neo
  layout: elk
  look: classic
---
flowchart LR
  subgraph Legend["Legend"]
    direction TB
    LegendEventA((" ")) eLegendEvent@== Event ==> LegendEventB((" "))
    LegendScalingA((" ")) eLegendScaling@== KEDA Scaling Signal ==> LegendScalingB((" "))
    LegendProcessingA((" ")) eLegendProcessing@== Processing ==> LegendProcessingB((" "))
    LegendStsA((" ")) eLegendSts@-. STS .-> LegendStsB((" "))
    LegendLogsA((" ")) eLegendLogs@== Logs ==> LegendLogsB((" "))
    LegendMonitoringA((" ")) eLegendMonitoring@== Monitoring ==> LegendMonitoringB((" "))
    LegendExternalA((" ")) eLegendExternal@== External Integration ==> LegendExternalB((" "))
  end

  subgraph EventSources["Event Sources"]
    direction TB
    ControlPlane["Control Plane"]
    OtherAPIs["External APIs"]
    Schedulers["Schedulers / Jobs"]
  end

  subgraph Platform["Platform"]
    direction LR

    subgraph AWSCloud["AWS Cloud"]
      direction LR

      subgraph DataDevOpsAccount["AWS DataDevOps Account (+ Tools)"]
        direction LR
        DataAccountRole["Cross-Account IAM Role"]

        subgraph VpcData["VPC A"]
          direction LR
          EventIngress["Event Ingress"]
          RegistryDynamoDB[("Operational DynamoDB")]

          subgraph EksData["EKS Cluster"]
            direction LR
            AuthData["Event Auth"]
            ValidationData["Event Validation"]

            subgraph Brokers["Event Backbones"]
              direction TB
              NatsStream[("NATS JetStream<br/>stream / durable consumer")]
              SqsQueue[("Amazon SQS<br/>queue / DLQ")]
              KafkaTopic[("Kafka<br/>topic / consumer group")]
            end

            subgraph KedaScalers["KEDA ScaledObjects"]
              direction TB
              KedaNats["NATS Scaler"]
              KedaSqs["AWS SQS Scaler"]
              KedaKafka["Kafka Scaler"]
            end

            subgraph EventConsumers["Event Consumer Workers"]
              direction TB
              NatsWorkers["NATS Worker Pods"]
              SqsWorkers["SQS Worker Pods"]
              KafkaWorkers["Kafka Worker Pods"]
            end

            subgraph DataOperations["Data Operation Services"]
              direction TB
              CreateData["Create"]
              ReadData["Read"]
              UpdateData["Update"]
              DeleteData["Delete"]
              ReplicationData["Replication"]
            end

            WatcherData["Watcher"]
            LogsData["Logs"]
          end
        end
      end

      subgraph TargetAccount["Target Account"]
        direction TB
        StsService{"STS"}

        subgraph TargetVpc["VPC B"]
          direction TB
          TargetDataServices["Managed Data Services<br/>RDS | DynamoDB | DocumentDB<br/>Redis | Keyspaces"]
        end
      end
    end
  end

  ControlPlane eControlPlaneIngress@== Signed Event ==> EventIngress
  OtherAPIs eOtherApisIngress@== Signed Event ==> EventIngress
  Schedulers eSchedulersIngress@== Scheduled Event ==> EventIngress

  EventIngress eIngressAuth@== Event Identity ==> AuthData
  AuthData eAuthValidation@== Authorized Event ==> ValidationData

  ValidationData eValidationNats@== Publish Event ==> NatsStream
  ValidationData eValidationSqs@== Publish Event ==> SqsQueue
  ValidationData eValidationKafka@== Publish Event ==> KafkaTopic

  NatsStream eNatsKeda@== Pending Messages ==> KedaNats
  SqsQueue eSqsKeda@== Approximate Messages ==> KedaSqs
  KafkaTopic eKafkaKeda@== Consumer Lag ==> KedaKafka

  KedaNats eKedaNatsWorkers@== Scale 0..N ==> NatsWorkers
  KedaSqs eKedaSqsWorkers@== Scale 0..N ==> SqsWorkers
  KedaKafka eKedaKafkaWorkers@== Scale 0..N ==> KafkaWorkers

  NatsStream eNatsWorkers@== Consume Event ==> NatsWorkers
  SqsQueue eSqsWorkers@== Consume Event ==> SqsWorkers
  KafkaTopic eKafkaWorkers@== Consume Event ==> KafkaWorkers

  NatsWorkers eNatsCreate@== Process Command ==> CreateData
  NatsWorkers eNatsRead@== Process Query Event ==> ReadData
  SqsWorkers eSqsUpdate@== Process Command ==> UpdateData
  SqsWorkers eSqsDelete@== Process Command ==> DeleteData
  KafkaWorkers eKafkaReplication@== Process Stream ==> ReplicationData

  CreateData eCreateTargetDataServices@== Execute Action ==> TargetDataServices
  ReadData eReadTargetDataServices@== Execute Action ==> TargetDataServices
  UpdateData eUpdateTargetDataServices@== Execute Action ==> TargetDataServices
  DeleteData eDeleteTargetDataServices@== Execute Action ==> TargetDataServices
  ReplicationData eReplicationTargetDataServices@== Execute Action ==> TargetDataServices

  AuthData eAuthDataLogs@== Log Event ==> LogsData
  ValidationData eValidationLogs@== Log Event ==> LogsData
  NatsWorkers eNatsWorkersLogs@== Log Event ==> LogsData
  SqsWorkers eSqsWorkersLogs@== Log Event ==> LogsData
  KafkaWorkers eKafkaWorkersLogs@== Log Event ==> LogsData
  CreateData eCreateLogs@== Log Event ==> LogsData
  ReadData eReadLogs@== Log Event ==> LogsData
  UpdateData eUpdateLogs@== Log Event ==> LogsData
  DeleteData eDeleteLogs@== Log Event ==> LogsData
  ReplicationData eReplicationLogs@== Log Event ==> LogsData
  WatcherData eWatcherDataLogs@== Log Event ==> LogsData
  LogsData eLogsDataRegistry@== Persist Audit ==> RegistryDynamoDB
  ReplicationData eReplicationRegistry@== Load Registry ==> RegistryDynamoDB

  CreateData eCreateWatcher@== Monitor Execution ==> WatcherData
  ReadData eReadWatcher@== Monitor Execution ==> WatcherData
  UpdateData eUpdateWatcher@== Monitor Execution ==> WatcherData
  DeleteData eDeleteWatcher@== Monitor Execution ==> WatcherData
  ReplicationData eReplicationWatcher@== Monitor Execution ==> WatcherData
  WatcherData eWatcherTargetDataServices@== Monitoring ==> TargetDataServices

  DataAccountRole eDataRoleSts@-. STS .-> StsService
  CreateData eCreateAssumeRole@-. "STS:AssumeRole (cross-account)" .-> DataAccountRole
  ReadData eReadAssumeRole@-. "STS:AssumeRole (cross-account)" .-> DataAccountRole
  UpdateData eUpdateAssumeRole@-. "STS:AssumeRole (cross-account)" .-> DataAccountRole
  DeleteData eDeleteAssumeRole@-. "STS:AssumeRole (cross-account)" .-> DataAccountRole
  ReplicationData eReplicationAssumeRole@-. "STS:AssumeRole (cross-account)" .-> DataAccountRole

  classDef event stroke:#00C853,color:#00C853
  classDef scaling stroke:#FF6D00,color:#FF6D00
  classDef processing stroke:#00B8D4,color:#00B8D4
  classDef sts stroke:#AA00FF,color:#AA00FF
  classDef logs stroke:#2962FF,color:#2962FF
  classDef monitoring stroke:#F4511E,color:#F4511E
  classDef external stroke:#4BF0FC,color:#4BF0FC
  classDef awsAccount stroke:#E1BEE7
  classDef vpc stroke:#BBDEFB
  classDef eks stroke:#C8E6C9
  classDef broker fill:#F6FFF8,stroke:#00C853,color:#1B5E20
  classDef scaler fill:#FFF7ED,stroke:#FF6D00,color:#7C2D12
  classDef worker fill:#E0F7FA,stroke:#00B8D4,color:#004D40
  classDef operation fill:#F6FFF8,stroke:#00C853,color:#1B5E20
  classDef dataStore fill:#F7FAFF,stroke:#2962FF,color:#0D47A1
  classDef identity fill:#FFFDE7,stroke:#FFD600,color:#5D4600
  classDef legendEvent color:#00C853,stroke:#00C853
  classDef legendScaling color:#FF6D00,stroke:#FF6D00
  classDef legendProcessing color:#00B8D4,stroke:#00B8D4
  classDef legendSts color:#AA00FF,stroke:#AA00FF
  classDef legendLogs color:#2962FF,stroke:#2962FF
  classDef legendMonitoring color:#F4511E,stroke:#F4511E
  classDef legendExternal color:#4BF0FC,stroke:#4BF0FC

  class DataDevOpsAccount,TargetAccount awsAccount
  class VpcData,TargetVpc vpc
  class EksData,Brokers,KedaScalers,EventConsumers,DataOperations eks
  class NatsStream,SqsQueue,KafkaTopic broker
  class KedaNats,KedaSqs,KedaKafka scaler
  class NatsWorkers,SqsWorkers,KafkaWorkers worker
  class CreateData,ReadData,UpdateData,DeleteData,ReplicationData operation
  class RegistryDynamoDB,TargetDataServices dataStore
  class AuthData identity
  class LegendEventA,LegendEventB legendEvent
  class LegendScalingA,LegendScalingB legendScaling
  class LegendProcessingA,LegendProcessingB legendProcessing
  class LegendStsA,LegendStsB legendSts
  class LegendLogsA,LegendLogsB legendLogs
  class LegendMonitoringA,LegendMonitoringB legendMonitoring
  class LegendExternalA,LegendExternalB legendExternal

  class eControlPlaneIngress,eOtherApisIngress,eSchedulersIngress,eIngressAuth,eAuthValidation,eValidationNats,eValidationSqs,eValidationKafka,eNatsWorkers,eSqsWorkers,eKafkaWorkers,eLegendEvent event
  class eNatsKeda,eSqsKeda,eKafkaKeda,eKedaNatsWorkers,eKedaSqsWorkers,eKedaKafkaWorkers,eLegendScaling scaling
  class eNatsCreate,eNatsRead,eSqsUpdate,eSqsDelete,eKafkaReplication,eCreateTargetDataServices,eReadTargetDataServices,eUpdateTargetDataServices,eDeleteTargetDataServices,eReplicationTargetDataServices,eLegendProcessing processing
  class eDataRoleSts,eCreateAssumeRole,eReadAssumeRole,eUpdateAssumeRole,eDeleteAssumeRole,eReplicationAssumeRole,eLegendSts sts
  class eAuthDataLogs,eValidationLogs,eNatsWorkersLogs,eSqsWorkersLogs,eKafkaWorkersLogs,eCreateLogs,eReadLogs,eUpdateLogs,eDeleteLogs,eReplicationLogs,eWatcherDataLogs,eLogsDataRegistry,eReplicationRegistry,eLegendLogs logs
  class eCreateWatcher,eReadWatcher,eUpdateWatcher,eDeleteWatcher,eReplicationWatcher,eWatcherTargetDataServices,eLegendMonitoring monitoring
  class eLegendExternal external

