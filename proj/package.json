{
  "name": "aws-resource-control-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate:resource-contracts": "node scripts/generate-tofu-resource-contracts.mjs",
    "seed:localstack:resources": "node scripts/localstack/seed-random-resources.mjs",
    "dev": "npm run watch",
    "watch": "npm-run-all --parallel watch:backend watch:frontend",
    "dev:backend": "npm run watch:backend",
    "dev:frontend": "npm run watch:frontend",
    "watch:backend": "npm --workspace @platform/backend run watch",
    "watch:frontend": "npm --workspace @platform/frontend run watch",
    "build": "npm-run-all build:shared build:backend build:frontend",
    "build:shared": "npm --workspace @platform/shared run build",
    "build:backend": "npm --workspace @platform/backend run build",
    "build:frontend": "npm --workspace @platform/frontend run build",
    "typecheck": "npm-run-all typecheck:*",
    "typecheck:shared": "npm --workspace @platform/shared run build",
    "typecheck:backend": "npm --workspace @platform/backend run typecheck",
    "typecheck:frontend": "npm --workspace @platform/frontend run typecheck"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "~5.5.4"
  }
}
