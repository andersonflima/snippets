# Ambiente LOCAL do stack (docker compose). Copie para `.env`:
#   cp .env.example .env
# NÃO usar em produção. Segredos aqui são apenas de desenvolvimento.

# Segredo do JWT de sessão do BFF (troque por um valor próprio).
BFF_JWT_SECRET=dev-local-secret-change-me

# Local não tem Cognito: BFF encaminha ao gateway sem token M2M (só o ator).
# Em produção mantenha true (ou omita) e configure BFF_M2M_* + Cognito.
BFF_M2M_ENABLED=false

# Usuário de dev p/ login no BFF: admin / admin (senha em bcrypt).
BFF_USERS=[{"username":"admin","passwordHash":"$2b$12$0v8u7LH7Jq1elqam5L4YEOp3MmCmd6rx5TiJ0S9K0neI99ft0sr4u","roles":["admin"]}]

# Porta pública do frontend (http://localhost:8088).
FRONTEND_PORT=8088

# Região default para os SDKs boto3 dos microserviços.
AWS_DEFAULT_REGION=us-east-1
