{
  "allowedRegions": [
    "sa-east-1"
  ],
  "environments": {
    "dev": {
      "requireGmudForMutations": false
    },
    "homol": {
      "requireGmudForMutations": false,
      "deniedOperations": [
        "RestoreDBClusterFromS3",
        "RestoreDBInstanceFromS3"
      ]
    },
    "staging": {
      "requireGmudForMutations": false,
      "deniedOperations": [
        "RestoreDBClusterFromS3",
        "RestoreDBInstanceFromS3"
      ]
    },
    "prod": {
      "requireGmudForMutations": true,
      "deniedOperations": [
        "ImportTable"
      ]
    }
  },
  "exceptions": []
}
