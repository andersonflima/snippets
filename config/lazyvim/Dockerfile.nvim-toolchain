# Toolchain CLI-only para o fluxo LazyVim-com-Docker: base Debian slim (glibc),
# sem X11/UI, apenas runtimes + LSPs/formatters consumidos via docker exec.
# trixie (Debian 13) em vez de bookworm porque o LazyVim exige Neovim >= 0.9 e
# o gopls atual exige Go recente — bookworm empacota nvim 0.7 / go 1.19.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV GO111MODULE=on
ENV GOBIN=/usr/local/bin

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    cargo \
    curl \
    elixir \
    erlang-dev \
    g++ \
    gcc \
    git \
    golang-go \
    lua5.1 \
    luarocks \
    make \
    neovim \
    nodejs \
    npm \
    openjdk-21-jre-headless \
    python3 \
    python3-pip \
    python3-venv \
    ripgrep \
    ruby \
    shellcheck \
    shfmt \
    unzip \
    xz-utils \
    zip \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g \
    @fsouza/prettierd \
    @tailwindcss/language-server \
    bash-language-server \
    eslint_d \
    pyright \
    prettier \
    typescript \
    typescript-language-server \
    vscode-langservers-extracted \
    yaml-language-server \
  && npm cache clean --force

RUN python3 -m pip install --no-cache-dir --break-system-packages black ruff

RUN go install golang.org/x/tools/gopls@latest \
  && go clean -cache -modcache

# --root /usr/local deixa os binarios em /usr/local/bin, no PATH de qualquer
# docker exec (o ~/.cargo/bin da imagem antiga dependia de shell de login).
RUN cargo install --locked --root /usr/local selene stylua \
  && rm -rf /root/.cargo/registry /root/.cargo/git

RUN luarocks install luacheck

WORKDIR /workspace

CMD ["bash", "-lc", "while true; do sleep 3600; done"]
