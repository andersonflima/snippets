# Toolchain CLI-only para o fluxo LazyVim-com-Docker: base oficial Node em
# Debian slim (glibc), sem X11/UI, apenas runtimes + LSPs/formatters consumidos
# via docker exec. Node/npm vêm prontos da imagem (sem apt nodejs/npm) e não há
# compilação Rust: stylua é instalado pelo pacote npm oficial (binário), e o
# lint de Lua fica com luacheck — menos pontos de falha de rede corporativa.
# Variante trixie (Debian 13) porque o LazyVim exige Neovim >= 0.9 e o gopls
# atual exige Go recente — bookworm empacota nvim 0.7 / go 1.19.
FROM node:22-trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV GO111MODULE=on
ENV GOBIN=/usr/local/bin

RUN apt-get update -o Acquire::Retries=3 \
  && apt-get install -y --no-install-recommends -o Acquire::Retries=3 \
    bash \
    ca-certificates \
    curl \
    elixir \
    erlang-dev \
    g++ \
    gcc \
    git \
    golang-go \
    lua5.1 \
    luarocks \
    make \
    neovim \
    openjdk-21-jre-headless \
    python3 \
    python3-pip \
    python3-venv \
    ripgrep \
    ruby \
    shellcheck \
    shfmt \
    unzip \
    xz-utils \
    zip \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g --fetch-retries=5 \
    @fsouza/prettierd \
    @johnnymorganz/stylua-bin \
    @tailwindcss/language-server \
    bash-language-server \
    eslint_d \
    pyright \
    prettier \
    typescript \
    typescript-language-server \
    vscode-langservers-extracted \
    yaml-language-server \
  && npm cache clean --force

RUN python3 -m pip install --no-cache-dir --break-system-packages black ruff

RUN go install golang.org/x/tools/gopls@latest \
  && go clean -cache -modcache

RUN luarocks install luacheck

WORKDIR /workspace

CMD ["bash", "-lc", "while true; do sleep 3600; done"]
