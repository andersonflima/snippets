# syntax=docker/dockerfile:1.7
# Toolchain CLI-only para o fluxo LazyVim-com-Docker: base oficial Node em
# Debian slim (glibc), sem X11/UI, apenas runtimes + LSPs/formatters consumidos
# via docker exec. Node/npm vêm prontos da imagem (sem apt nodejs/npm) e não há
# compilação Rust: stylua é instalado pelo pacote npm oficial (binário), e o
# lint de Lua fica com luacheck — menos pontos de falha de rede corporativa.
# Variante trixie (Debian 13) porque o LazyVim exige Neovim >= 0.9 —
# bookworm empacota nvim 0.7. (Go/gopls removidos por ora: atrás do proxy
# corporativo o go não tem bypass de TLS confiável; volta quando houver CA.)
#
# Cache de build (BuildKit): apt/npm/pip/go usam --mount=type=cache, então o
# que já foi baixado sobrevive entre builds MESMO quando a camada invalida
# (ex.: troca de base ou da lista de pacotes) — em rede corporativa lenta é a
# diferença entre re-baixar centenas de MB e reaproveitar tudo. Os caches vivem
# no builder, não na imagem final (o tamanho não muda). Proxy corporativo:
# HTTP_PROXY/HTTPS_PROXY/NO_PROXY do ambiente são repassados pelo BuildKit
# automaticamente como build args — não precisam constar aqui.
FROM node:22-trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
# strict-ssl do npm, mesmo knob dos demais Dockerfiles do repo: em rede
# corporativa com CA interna/proxy que quebra TLS, buildar com
# --build-arg NPM_CONFIG_STRICT_SSL=false. Default true (seguro).
ARG NPM_CONFIG_STRICT_SSL=true
ENV NPM_CONFIG_STRICT_SSL=${NPM_CONFIG_STRICT_SSL}

# strict-ssl do pip (mesmo padrão do bff): proxy corporativo que intercepta
# TLS quebra o pip com CERTIFICATE_VERIFY_FAILED. Buildar com
# PIP_TRUSTED_HOST="pypi.org files.pythonhosted.org <host-do-indice>" pula a
# verificação SÓ desses hosts. Vazio por padrão (SSL ligado).
ARG PIP_TRUSTED_HOST=""
ENV PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}

# apt atrás de proxy corporativo: quando nem via proxy o índice chega íntegro
# ("repository is not signed"), APT_INSECURE=1 marca as sources Debian como
# confiáveis e permite repositório sem assinatura — usar SÓ na rede corporativa.
ARG APT_INSECURE=0
ENV APT_INSECURE=${APT_INSECURE}
RUN if [ "$APT_INSECURE" = "1" ]; then \
      sed -i '/^Types: deb$/a Trusted: yes\nAllow-Insecure: yes' /etc/apt/sources.list.d/debian.sources; \
    fi

# Camada 1 — toolchains PESADOS e estáveis (mudam raro; ficam no topo para as
# iterações abaixo não os invalidarem). ForceIPv4 evita os timeouts de IPv6
# clássicos de proxy corporativo. keep-downloaded-debs: o default da imagem
# apaga os .deb após instalar; o cache mount só ajuda se eles ficarem.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
  && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-debs \
  && if [ "$APT_INSECURE" = "1" ]; then APT_OPTS="-o Acquire::AllowInsecureRepositories=true --allow-unauthenticated"; else APT_OPTS=""; fi \
  && apt-get update -o Acquire::Retries=3 -o Acquire::ForceIPv4=true $APT_OPTS \
  && apt-get install -y --no-install-recommends -o Acquire::Retries=3 -o Acquire::ForceIPv4=true $APT_OPTS \
    elixir \
    erlang-dev \
    g++ \
    gcc \
    openjdk-21-jre-headless \
    python3 \
    python3-pip \
    python3-venv \
    ruby

# Camada 2 — utilitários LEVES (a parte que mais itera; re-rodar só ela é
# barato e o apt-get update reaproveita as listas do cache mount).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    if [ "$APT_INSECURE" = "1" ]; then APT_OPTS="-o Acquire::AllowInsecureRepositories=true --allow-unauthenticated"; else APT_OPTS=""; fi \
  && apt-get update -o Acquire::Retries=3 -o Acquire::ForceIPv4=true $APT_OPTS \
  && apt-get install -y --no-install-recommends -o Acquire::Retries=3 -o Acquire::ForceIPv4=true $APT_OPTS \
    bash \
    ca-certificates \
    curl \
    git \
    lua-check \
    lua5.1 \
    luarocks \
    make \
    neovim \
    ripgrep \
    shellcheck \
    shfmt \
    unzip \
    xz-utils \
    zip

# CA corporativa OPCIONAL (proxy que intercepta TLS): entra como secret e é
# instalada no trust store do sistema — certificado de CA é material PÚBLICO,
# pode persistir na imagem. Com ela, go/curl/npm validam TLS normalmente, sem
# precisar de bypass. O setup script passa --secret id=corp_ca via CORP_CA_FILE.
RUN --mount=type=secret,id=corp_ca,target=/tmp/corp-ca.crt,required=false \
    if [ -s /tmp/corp-ca.crt ]; then \
      cp /tmp/corp-ca.crt /usr/local/share/ca-certificates/corp-ca.crt \
      && update-ca-certificates; \
    fi

# npm global com cache persistente: sem `npm cache clean` (o cache mora no
# mount do builder, não na camada da imagem) e com os mesmos timeouts/retries
# usados nos outros Dockerfiles node do ecossistema.
# ~/.npmrc do host (proxy/registry/CA/token corporativo) entra como SECRET:
# disponível só durante este RUN, nunca persiste em camada da imagem (um COPY
# assaria credenciais no histórico). required=false mantém o build funcionando
# em máquinas sem o arquivo. O setup script passa --secret id=npmrc,src=~/.npmrc.
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=secret,id=npmrc,target=/root/.npmrc,required=false \
    sh -c 'if [ -s /usr/local/share/ca-certificates/corp-ca.crt ]; then export NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/corp-ca.crt; fi; \
    NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=2000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=10000 \
    npm install -g --prefer-offline --no-audit --no-fund \
    @fsouza/prettierd \
    @johnnymorganz/stylua-bin \
    @tailwindcss/language-server \
    bash-language-server \
    eslint_d \
    pyright \
    prettier \
    typescript \
    typescript-language-server \
    vscode-langservers-extracted \
    yaml-language-server'

# pip.conf do host (index-url/proxy/CA corporativo) como SECRET, igual ao
# npmrc: visível só neste RUN em /etc/pip.conf (config global do pip), nunca
# persiste na imagem. O setup script passa --secret id=pip_conf automaticamente.
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=secret,id=pip_conf,target=/etc/pip.conf,required=false \
    python3 -m pip install --break-system-packages black ruff

WORKDIR /workspace

CMD ["bash", "-lc", "while true; do sleep 3600; done"]
