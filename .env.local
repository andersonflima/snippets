# Ambiente LOCAL do stack (docker compose). NÃO usar em produção.
# Cópia temporária do .env (dados de dev/falsos) para replicar o ambiente
# rápido em outra máquina. Depois: `cp .env.local .env` e remova este arquivo.
# Usuário de dev para login no BFF: admin / admin (senha em bcrypt).
BFF_JWT_SECRET=dev-local-secret-change-me
# Local não tem Cognito: BFF encaminha ao gateway sem token M2M (só ator).
BFF_M2M_ENABLED=false
BFF_USERS=[{"username":"admin","passwordHash":"$2b$12$0v8u7LH7Jq1elqam5L4YEOp3MmCmd6rx5TiJ0S9K0neI99ft0sr4u","roles":["admin"]}]
FRONTEND_PORT=8088
AWS_DEFAULT_REGION=us-east-1
